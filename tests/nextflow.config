/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

// Or any resources requirements
params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/spatialaxe/'

    // `outdir` defaults to null (nextflow.config), and the timeline / report /
    // trace / dag blocks interpolate it unconditionally:
    //
    //     file = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
    //
    // A pipeline run always supplies --outdir, but a module test does not, so
    // without this every test writes into a literal `null/` directory in the
    // launch dir. Worse, `trace_report_suffix` has one-second resolution, so two
    // tests starting in the same second resolve to the same filename and the
    // second one dies with
    // `FileAlreadyExistsException: null/pipeline_info/execution_timeline_....html`
    // -- which reads as a module failure and is not one.
    //
    // A unique directory per run keeps the reports off the repo and out of each
    // other's way. Assertions use `process.out` and nf-test's own output
    // directory, so nothing depends on this value.
    outdir = "${System.getProperty('java.io.tmpdir')}/nft-outdir-${UUID.randomUUID()}"
}

aws.client.anonymous = true // fixes S3 access issues on self-hosted runners
